{
  "name": "dsh-markitdown",
  "version": "0.1.2",
  "description": "Microsoft MarkItDown as a DeepSeek Harness tool: convert PDF, Word, Excel, PowerPoint, HTML, CSV, EPUB, or a URL into Markdown the model can read.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "markitdown",
    "markdown",
    "pdf",
    "docx",
    "xlsx",
    "pptx",
    "epub",
    "document-conversion",
    "ocr"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiekesu967/dsh-markitdown.git"
  },
  "homepage": "https://github.com/jiekesu967/dsh-markitdown#readme",
  "bugs": {
    "url": "https://github.com/jiekesu967/dsh-markitdown/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-fs": "^0.1.5-rc.1",
    "@types/node": "^22.17.2",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/build.mjs --noEmit",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:inline": "node --test-isolation=none --test \"tests/*.test.mjs\"",
    "pack": "npm pack",
    "release": "node scripts/release.mjs"
  }
}
